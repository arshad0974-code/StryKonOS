rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if false;

      // Scoped Subcollections: Tasks
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Scoped Subcollections: Clients
      match /clients/{clientId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(clientId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(clientId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      // Scoped Subcollections: Projects
      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(projectId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // Scoped Subcollections: Focus Sessions
      match /focusSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Scoped Subcollections: Distractions
      match /distractions/{distractionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(distractionId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(distractionId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(distractionId);
      }
    }
  }
}
